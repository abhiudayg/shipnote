---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';

const features = [
  { title: 'Nightly dataset from GitHub', status: 'Working', body: 'A scheduled workflow finds every public repository where your account committed in the last 30 days, using GitHub contribution data. Private repositories are never queried.', size: 'md:col-span-2' },
  { title: 'Full diffs, archived locally', status: 'Working', body: 'Commits are exported with full patches. fetch downloads the artifact into a dated folder on your machine, so later steps need no network.', size: '' },
  { title: 'Secret scanning before upload', status: 'Working', body: 'Gitleaks, pinned to a version, scans the dataset. A finding fails the run. A small allowlist covers known false positives.', size: '' },
  { title: 'Ranked commit selection', status: 'Working', body: 'select skips merges, lockfile-only changes, used commits, and denylisted repos. It ranks the rest by change size, new files, and message quality.', size: 'md:col-span-2' },
  { title: 'Drafts grounded in commit SHAs', status: 'Planned', body: 'Drafts will cite the commits they are based on. A claim with no matching commit is removed before you see the draft.', size: '' },
  { title: 'Review and approval', status: 'Planned', body: 'A review step shows each draft beside its evidence. You approve, edit, or reject it. Nothing is posted by shipnote.', size: '' },
  { title: 'Voice and context from agent-brain', status: 'Planned', body: 'Past posts and project notes will be stored in agent-brain and used as context while drafting, so drafts match your voice and avoid repeats.', size: 'md:col-span-2' },
  { title: 'Works on your fork', status: 'Working', body: 'The workflow reads the account from the repository owner. A fork needs two settings and one manual run, with no code changes.', size: '' },
];
---

<Base title="Features: shipnote" description="What shipnote does today, what is planned, and how each part is verified." active="/features/">
  <PageHero
    eyebrow="Features"
    title="What it does, and what is next"
    lead="Each feature shows its status. Nothing marked planned is in the code yet."
  />
  <section class="mx-auto grid max-w-6xl gap-4 px-5 pb-24 md:grid-cols-3">
    {features.map((f) => (
      <article class:list={['gradient-border rounded-2xl p-7 transition-transform duration-300 hover:-translate-y-0.5', f.size]}>
        <div class="flex items-center justify-between gap-4">
          <h2 class="font-semibold tracking-tight">{f.title}</h2>
          <span class:list={['shrink-0 font-mono text-[11px]', f.status === 'Working' ? 'text-sky-400' : 'text-zinc-500']}>{f.status}</span>
        </div>
        <p class="mt-3 text-sm leading-7 text-zinc-400">{f.body}</p>
      </article>
    ))}
  </section>
</Base>
