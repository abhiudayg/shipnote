---
import Docs from '../layouts/Docs.astro';

const milestones = [
  { id: 'M0', title: 'Evaluation set', status: 'In progress', body: 'Twelve commit cases are in the repository, with notes on what a good post should say. On the real model, every case kept its items, with 100% SHA validity and 83% mode match. Approval rate is tracked by stats once drafts are reviewed.' },
  { id: 'M1', title: 'Fetch and select', status: 'Done', body: 'Download and archive the dataset, drop used and trivial commits, and rank the rest.' },
  { id: 'M1b', title: 'Memory from agent-brain', status: 'In progress', body: 'Voice facts are read through agent-brain recall. remember stores one fact, and import-voice stores a folder of writing without duplicates. Pending merge.' },
  { id: 'M2', title: 'Story drafts for tweets', status: 'In progress', body: 'Drafts cite commit SHAs and name only files, identifiers, and numbers that appear in the cited commits. Tweet wording is checked against the cited commits, and links go under replies. Invented-claim controls are rejected. Whether a draft is good is still a judgment made by hand.' },
  { id: 'M3', title: 'Blog drafts and theme mode', status: 'Planned', body: 'Blog posts in story and theme modes, agent-brain retrieval, and quality checks for theme posts.' },
  { id: 'M4', title: 'Review and approve', status: 'In progress', body: 'review shows each draft beside its evidence, review --decide takes one key per draft, and approve, mark-used, and stats are built. Two weeks of daily use come before anything changes.' },
];
---

<Docs title="Roadmap: shipnote" description="What shipnote builds next: the evaluation set, the drafting CLI, blog drafts, and the daily review flow." active="/roadmap/">
  <p class="font-mono text-xs tracking-wider text-sky-400 uppercase">Roadmap</p>
  <h1 class="text-gradient mt-3 text-4xl font-semibold tracking-[-0.035em] md:text-5xl">Milestones</h1>
  <p class="mt-4 text-lg leading-7 text-zinc-400">The nightly dataset, selection, drafting, review, help, and progress are built. The next step is judging draft quality by hand on real posts.</p>
  <ol class="mt-12 space-y-4">
    {milestones.map((m) => (
      <li class="gradient-border flex gap-5 rounded-2xl p-6">
        <span class="font-mono text-sm text-sky-400">{m.id}</span>
        <div class="flex-1">
          <div class="flex items-center justify-between gap-4">
            <h2 class="font-semibold">{m.title}</h2>
            <span class:list={['font-mono text-[11px]', m.status === 'Done' ? 'text-sky-400' : 'text-zinc-500']}>{m.status}</span>
          </div>
          <p class="mt-2 text-sm leading-7 text-zinc-400">{m.body}</p>
        </div>
      </li>
    ))}
  </ol>
  <p class="mt-12 text-sm text-zinc-500">Out of scope for now: auto-posting, scheduling, analytics, and drafting from private repositories.</p>
</Docs>
