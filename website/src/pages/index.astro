---
import Base from '../layouts/Base.astro';
const repo = 'https://github.com/abhiudayg/shipnote';

const modules = [
  { stage: 'Dataset', status: 'Working', title: 'Nightly export', body: 'Public commits and full diffs from the last 30 days, built by a scheduled GitHub Action.' },
  { stage: 'Select', status: 'Working', title: 'Ranked commits', body: 'Merges, lockfile-only changes, and used commits are skipped. The rest are ranked by change and message quality.' },
  { stage: 'Draft', status: 'In progress', title: 'Grounded drafts', body: 'Tweets and blog drafts that cite commit SHAs. Claims that name something missing from the cited commits are removed.' },
  { stage: 'Review', status: 'In progress', title: 'You approve', body: 'Each draft sits beside its evidence. You approve, edit, or reject with one key. Nothing posts automatically.' },
];

const features = [
  { title: 'Every claim traced to a commit', body: 'Each factual statement links to the commit and file it came from. Validation runs before you see a draft.', badge: 'SHA and grounding checks · in progress', size: 'md:col-span-2' },
  { title: 'No auto-posting', body: 'shipnote has no posting code. Drafts are files, and you decide what happens next.', badge: 'By design', size: '' },
  { title: 'Runs on your account', body: 'The nightly job reads the account from the repository owner. A fork needs two settings and one run.', badge: 'Fork and run', size: '' },
  { title: 'Secrets scanned before upload', body: 'Gitleaks, pinned to a version, scans the dataset. A finding fails the run before anything is uploaded.', badge: 'Working', size: 'md:col-span-2' },
  { title: 'Your voice, not a generic one', body: 'Drafts are checked against your past posts, stored as facts in agent-brain, so the tone matches how you already write.', badge: 'In progress', size: '' },
  { title: 'Repeat checks', body: 'A draft that repeats an approved post from the last 30 days is removed before it reaches review.', badge: 'In progress', size: '' },
];

const steps = [
  { id: '01', title: 'Export', body: 'A scheduled GitHub Action exports your public commits and full diffs, scans them for secrets, and uploads a short-lived artifact.', code: 'cron: nightly · days: 30' },
  { id: '02', title: 'Select', body: 'Used and trivial commits drop out. The rest are ranked by how much changed and how clear the message is.', code: 'bun cli/shipnote.ts select' },
  { id: '03', title: 'Approve', body: 'Drafts land as files beside their evidence, so you review, edit, and approve each one. Real-model quality is the next thing measured.', code: 'status: in progress (M2 to M4)' },
];
---

<Base
  title="shipnote: Turn what you ship into posts you approve"
  description="shipnote turns the work you ship into tweets and blog drafts. Every claim is tied to a commit, and nothing publishes without your approval."
  active="/"
>
  <main>
    <section class="surface-glow px-5 pt-24 pb-20 md:pt-32">
      <div class="mx-auto flex max-w-4xl flex-col items-center text-center">
        <a href="/changelog/" class="mb-7 inline-flex items-center gap-2 rounded-full border border-white/[0.1] bg-white/[0.03] py-1 pr-3.5 pl-1.5 text-xs text-zinc-300 transition-colors hover:border-white/[0.2]">
          <span class="rounded-full bg-sky-400/15 px-2 py-0.5 font-mono text-[10px] text-sky-300">NEW</span>
          Nightly dataset is live
          <span class="text-zinc-500">→</span>
        </a>
        <h1 class="text-gradient text-[2.5rem] leading-[2.75rem] font-semibold tracking-[-0.04em] md:text-[3.5rem] md:leading-[4rem]">
          Turn what you ship into posts you approve.
        </h1>
        <p class="mt-6 max-w-xl text-base leading-7 text-zinc-400 md:text-lg">
          shipnote reads your public commits each night and prepares material for tweets and blog posts. Every claim is tied to a commit. Nothing goes out until you approve it.
        </p>
        <div class="mt-9 flex flex-col items-center gap-3 sm:flex-row">
          <a href="/setup/" class="rounded-lg bg-white px-5 py-2.5 text-sm font-medium text-black transition-colors hover:bg-sky-300">Get started</a>
          <a href={repo} class="rounded-lg border border-white/[0.12] bg-white/[0.03] px-5 py-2.5 text-sm font-medium transition-colors hover:border-white/[0.25]">View on GitHub</a>
        </div>
      </div>

      <div class="gradient-border mx-auto mt-20 max-w-5xl overflow-hidden rounded-2xl shadow-[0_40px_120px_-20px_rgba(56,189,248,0.25)]">
        <div class="flex items-center justify-between border-b border-white/[0.08] bg-white/[0.02] px-4 py-3">
          <div class="flex items-center gap-2">
            <span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
            <span class="ml-3 font-mono text-xs text-zinc-400">shipnote · pipeline</span>
          </div>
          <span class="font-mono text-xs text-sky-400">human gate · review required</span>
        </div>
        <div class="grid gap-px bg-white/[0.06] md:grid-cols-4">
          {modules.map((m, i) => (
            <div class="bg-[#0a0a0c] p-5">
              <div class="flex items-center justify-between">
                <span class="font-mono text-[11px] text-zinc-500">0{i + 1} · {m.stage}</span>
                <span class:list={['font-mono text-[10px]', m.status === 'Working' ? 'text-sky-400' : 'text-zinc-600']}>{m.status}</span>
              </div>
              <h3 class="mt-4 text-sm font-semibold">{m.title}</h3>
              <p class="mt-2 text-xs leading-5 text-zinc-400">{m.body}</p>
            </div>
          ))}
        </div>
        <div class="flex flex-wrap items-center justify-between gap-3 border-t border-white/[0.08] bg-black/60 px-5 py-4 font-mono text-xs text-zinc-400">
          <span>2026-10-30: 450 commits, 447 selected, 3 skipped</span>
          <span class="text-zinc-500">drafting and approval: next milestones</span>
        </div>
      </div>
    </section>

    <section class="px-5 py-24" id="features">
      <div class="mx-auto max-w-6xl">
        <p class="font-mono text-xs tracking-wider text-sky-400 uppercase">Features</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-[-0.03em] md:text-4xl">Built for technical integrity</h2>
        <p class="mt-3 max-w-xl text-zinc-400">Written for developers who care about accuracy, their own data, and getting credit correctly.</p>
        <div class="mt-12 grid gap-4 md:grid-cols-3">
          {features.map((item) => (
            <article class:list={['gradient-border rounded-2xl p-7 transition-transform duration-300 hover:-translate-y-0.5', item.size]}>
              <h3 class="text-lg font-semibold tracking-tight">{item.title}</h3>
              <p class="mt-3 text-sm leading-6 text-zinc-400">{item.body}</p>
              <span class="mt-6 inline-flex rounded-md border border-white/[0.1] bg-black/50 px-2.5 py-1 font-mono text-[11px] text-zinc-400">{item.badge}</span>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="px-5 py-24" id="how-it-works">
      <div class="mx-auto max-w-6xl">
        <p class="font-mono text-xs tracking-wider text-sky-400 uppercase">How it works</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-[-0.03em] md:text-4xl">From commit to a post you approved</h2>
        <div class="mt-12 grid gap-4 md:grid-cols-3">
          {steps.map((s) => (
            <div class="rounded-2xl border border-white/[0.08] bg-[#0a0a0c] p-7">
              <span class="font-mono text-sm text-sky-400">{s.id}</span>
              <h3 class="mt-4 text-lg font-semibold tracking-tight">{s.title}</h3>
              <p class="mt-3 text-sm leading-6 text-zinc-400">{s.body}</p>
              <p class="mt-6 rounded-md border border-white/[0.08] bg-black/60 px-3 py-2 font-mono text-[12px] text-zinc-300">{s.code}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="px-5 pb-24">
      <div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-6 rounded-2xl border border-white/[0.08] bg-[#0a0a0c] p-8 md:flex-row md:items-center md:p-10">
        <div>
          <p class="font-mono text-xs tracking-wider text-sky-400 uppercase">Privacy</p>
          <h2 class="mt-3 text-2xl font-semibold tracking-[-0.02em]">Local-first. No telemetry. Nothing posts automatically.</h2>
          <p class="mt-3 max-w-2xl text-sm leading-6 text-zinc-400">Code diffs and keys stay in your own runners or on your machine. shipnote has no posting code, so every publish is a step you take yourself.</p>
        </div>
        <a href="/privacy/" class="shrink-0 rounded-lg border border-white/[0.12] bg-white/[0.03] px-5 py-2.5 text-sm font-medium transition-colors hover:border-white/[0.25]">Read the privacy notes</a>
      </div>
    </section>

    <section class="px-5 py-24" id="get-started">
      <div class="gradient-border mx-auto max-w-4xl rounded-3xl p-10 text-center md:p-14">
        <p class="font-mono text-xs tracking-wider text-sky-400 uppercase">Get started</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-[-0.03em] md:text-4xl">Run it on your own account</h2>
        <p class="mx-auto mt-3 max-w-lg text-zinc-400">Fork the repository, then fetch and select from your own nightly dataset.</p>
        <div class="mt-9 overflow-hidden rounded-xl border border-white/[0.08] bg-black/70 text-left">
          <div class="flex items-center gap-2 border-b border-white/[0.08] px-4 py-2.5">
            <span class="h-2 w-2 rounded-full bg-white/15"></span>
            <span class="h-2 w-2 rounded-full bg-white/15"></span>
            <span class="h-2 w-2 rounded-full bg-white/15"></span>
            <span class="ml-2 font-mono text-[11px] text-zinc-500">bash</span>
          </div>
          <pre class="overflow-x-auto p-5 font-mono text-[13px] leading-7 text-zinc-300"><code>$ gh repo fork abhiudayg/shipnote --clone
$ cd shipnote && bun install
$ SHIPNOTE_REPO=you/shipnote bun cli/shipnote.ts fetch
$ bun cli/shipnote.ts select</code></pre>
        </div>
        <a href="/docs/" class="mt-8 inline-block text-sm text-sky-400 transition-colors hover:text-sky-300">Read the documentation →</a>
      </div>
    </section>
  </main>
</Base>
