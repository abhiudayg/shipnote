---
import Docs from '../layouts/Docs.astro';

const entries = [
  {
    date: '2026-10-31',
    title: 'Product page and analytics',
    items: [
      'Redesigned the home page as a product page: pipeline, features, how it works, privacy, and a fork-and-run section.',
      'Added Vercel Analytics to every page.',
      'Updated the roadmap for agent-brain memory. Voice facts are read through recall, and remember and import-corpus ship in agent-brain 1.0.0-rc6.',
    ],
  },
  {
    date: '2026-10-30',
    title: 'CLI reference and README revamp',
    items: [
      'Added fetch and select commands, with unit tests against a fixture patch.',
      'Changed the selection score to a log scale, so larger changes rank above smaller ones.',
      'Rewrote the README to describe what is built, including setup for a fork.',
    ],
  },
  {
    date: '2026-10-30',
    title: 'Website on Vercel',
    items: [
      'Deployed an Astro and Tailwind site with setup, privacy, roadmap, CLI, and documentation pages.',
      'Added the chevron logo and the black theme used across the site.',
    ],
  },
  {
    date: '2026-10-30',
    title: 'Nightly dataset',
    items: [
      'Workflow exports public commits with full diffs, scans them with gitleaks, and uploads a 10-day artifact.',
      'Repository discovery uses GitHub contribution data, filtered to public repositories.',
      'Scheduled and manual runs take a days input, with 30 days as the default.',
    ],
  },
];
---

<Docs title="Changelog: shipnote" description="Changes to the shipnote dataset job, the CLI, and the website." active="/changelog/">
  <p class="font-mono text-xs tracking-wider text-sky-400 uppercase">Changelog</p>
  <h1 class="text-gradient mt-3 text-4xl font-semibold tracking-[-0.035em] md:text-5xl">What changed</h1>
  <p class="mt-4 text-lg leading-7 text-zinc-400">Newest first. Entries describe what shipped, not what is planned.</p>
  <ol class="mt-12 space-y-10">
    {entries.map((entry) => (
      <li class="border-l border-white/[0.1] pl-6">
        <p class="font-mono text-xs text-zinc-500">{entry.date}</p>
        <h2 class="mt-2 text-xl font-semibold">{entry.title}</h2>
        <ul class="mt-4 space-y-2 text-sm leading-6 text-zinc-400">
          {entry.items.map((item) => (
            <li class="flex gap-3"><span class="text-sky-400">•</span><span>{item}</span></li>
          ))}
        </ul>
      </li>
    ))}
  </ol>
</Docs>
