---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import Docs from '../layouts/Docs.astro';

const changelog = readFileSync(join(process.cwd(), '..', 'CHANGELOG.md'), 'utf8');

const segments = (text: string) => text.split('`').map((part, index) => ({ part, code: index % 2 === 1 }));

const releases: { name: string; date: string | null; groups: { name: string; items: ReturnType<typeof segments>[] }[] }[] = [];
for (const line of changelog.split('\n')) {
  const version = line.match(/^## \[(.+?)\](?: - (\d{4}-\d{2}-\d{2}))?$/);
  if (version) {
    releases.push({ name: version[1], date: version[2] ?? null, groups: [] });
    continue;
  }
  const section = line.match(/^### (.+)$/);
  if (section && releases.length > 0) {
    releases[releases.length - 1].groups.push({ name: section[1], items: [] });
    continue;
  }
  const item = line.match(/^- (.+)$/);
  const group = releases[releases.length - 1]?.groups.at(-1);
  if (item && group) group.items.push(segments(item[1]));
}
---

<Docs title="Changelog: shipnote" description="Changes to the shipnote dataset job, the CLI, and the website." active="/changelog/">
  <p class="font-mono text-xs tracking-wider text-sky-400 uppercase">Changelog</p>
  <h1 class="text-gradient mt-3 text-4xl font-semibold tracking-[-0.035em] md:text-5xl">What changed</h1>
  <p class="mt-4 text-lg leading-7 text-zinc-400">Newest first. Entries describe what shipped, not what is planned.</p>
  <ol class="mt-12 space-y-10">
    {releases.map((release) => (
      <li class="border-l border-white/[0.1] pl-6">
        <p class="font-mono text-xs text-zinc-500">{release.date ?? 'Unreleased'}</p>
        <h2 class="mt-2 text-xl font-semibold">{release.name === 'Unreleased' ? 'Unreleased' : `Version ${release.name}`}</h2>
        {release.groups.map((group) => (
          <div class="mt-5">
            <h3 class="font-mono text-xs tracking-wider text-sky-400 uppercase">{group.name}</h3>
            <ul class="mt-3 space-y-2 text-sm leading-6 text-zinc-400">
              {group.items.map((item) => (
                <li class="flex gap-3">
                  <span class="text-sky-400">•</span>
                  <span>
                    {item.map((s) => (s.code ? <code class="font-mono text-zinc-200">{s.part}</code> : s.part))}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </li>
    ))}
  </ol>
</Docs>
