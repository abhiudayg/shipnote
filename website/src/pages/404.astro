---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---

<Base title="Page not found: shipnote" description="This page does not exist.">
  <PageHero eyebrow="404" title="Page not found" lead="The page you were looking for does not exist or has moved." />
  <div class="mx-auto flex max-w-6xl gap-3 px-5 pb-24">
    <a href="/" class="rounded-lg bg-white px-5 py-2.5 text-sm font-medium text-black transition-colors hover:bg-sky-300">Back to shipnote</a>
    <a href="/docs/" class="rounded-lg border border-white/[0.12] bg-white/[0.03] px-5 py-2.5 text-sm font-medium transition-colors hover:border-white/[0.25]">Documentation</a>
  </div>
</Base>
