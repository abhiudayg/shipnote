---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found: shipnote" description="This page does not exist.">
  <main class="mx-auto max-w-3xl px-5 pt-32 pb-32 text-center">
    <p class="font-mono text-sm text-sky-400">404</p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight">Page not found</h1>
    <p class="mt-4 text-zinc-400">The page you were looking for does not exist.</p>
    <a href="/" class="mt-10 inline-block rounded-lg bg-sky-400 px-6 py-2.5 text-sm font-semibold text-black shadow-[0_0_20px_rgba(56,189,248,0.22)] hover:bg-sky-300">Back to shipnote</a>
  </main>
</Base>
