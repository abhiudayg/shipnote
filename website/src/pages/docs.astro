---
import Docs from '../layouts/Docs.astro';
import PageHero from '../components/PageHero.astro';

const cards = [
  { title: 'Setup', href: '/setup/', body: 'Fork the repository, enable Actions, set DATASET_AUTHOR, and run the first 30-day build.' },
  { title: 'CLI reference', href: '/cli/', body: 'The fetch and select commands, their flags, and the environment variables they read.' },
  { title: 'How it works', href: '/how-it-works/', body: 'The stages of the pipeline, from the nightly export through selection, drafting, and review.' },
  { title: 'Privacy', href: '/privacy/', body: 'What is read, what is published as an artifact, and how the secret scan protects it.' },
  { title: 'Roadmap', href: '/roadmap/', body: 'Milestones for drafting, review, and approval, with what is done so far.' },
  { title: 'Changelog', href: '/changelog/', body: 'What changed in each release of the repository and the website.' },
];
---

<Docs title="Documentation: shipnote" description="Setup, CLI reference, pipeline details, privacy, and roadmap for shipnote." active="/docs/">
  <p class="font-mono text-xs tracking-wider text-sky-400 uppercase">Documentation</p>
  <h1 class="text-gradient mt-3 text-4xl font-semibold tracking-[-0.035em] md:text-5xl">Guides and reference</h1>
  <p class="mt-4 text-lg leading-7 text-zinc-400">Everything to run shipnote on your own account and your own machine.</p>
  <div class="mt-12 grid gap-4 sm:grid-cols-2">
    {cards.map((c) => (
      <a href={c.href} class="group gradient-border rounded-2xl p-6 transition-transform duration-300 hover:-translate-y-0.5">
        <h2 class="font-semibold group-hover:text-sky-300">{c.title}</h2>
        <p class="mt-2 text-sm leading-6 text-zinc-400">{c.body}</p>
        <span class="mt-5 inline-block font-mono text-xs text-zinc-500 group-hover:text-sky-400">Open →</span>
      </a>
    ))}
  </div>
</Docs>
