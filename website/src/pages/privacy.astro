---
import Docs from '../layouts/Docs.astro';

const sections = [
  { title: 'What it reads', body: 'The nightly job reads only public repositories where your account made commits in the window. Private repositories are excluded by the GitHub query itself.' },
  { title: 'What it publishes', body: 'The dataset is uploaded as a workflow artifact, which GitHub deletes after 10 days. It contains full diffs, so anyone with read access to the repository can download it during that window. Keep secrets out of commits.' },
  { title: 'Secret scanning', body: 'Gitleaks scans the dataset before upload, and a finding fails the run. It catches common secret formats but is not a guarantee. A small allowlist covers known false positives, such as Go module checksums.' },
  { title: 'What drafting sends', body: 'Drafting sends the selected commit diffs, your voice samples, and the recent approved posts it checks against to the agent provider you configure in shipnote.toml. Voice facts and approvals stay in your local agent-brain store and on your machine. shipnote sends nothing to any other service. This site runs no analytics or tracking scripts.' },
  { title: 'Nothing posts for you', body: 'shipnote never publishes to X, a blog, or any other platform. You review and approve each draft, then post it yourself.' },
];
---

<Docs title="Privacy: shipnote" description="What shipnote reads, what it publishes, and how the secret scan protects your commits." active="/privacy/">
  <p class="font-mono text-xs tracking-wider text-sky-400 uppercase">Privacy</p>
  <h1 class="text-gradient mt-3 text-4xl font-semibold tracking-[-0.035em] md:text-5xl">What is read, and what is not</h1>
  <p class="mt-4 text-lg leading-7 text-zinc-400">What shipnote reads, what it publishes, and what it does not do.</p>
  <div class="mt-12 space-y-4">
    {sections.map((s) => (
      <section class="rounded-2xl border border-white/[0.08] bg-white/[0.02] p-6">
        <h2 class="font-semibold">{s.title}</h2>
        <p class="mt-3 text-sm leading-7 text-zinc-400">{s.body}</p>
      </section>
    ))}
  </div>
</Docs>
