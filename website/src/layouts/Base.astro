---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  active?: string;
}

const { title, description, active = '' } = Astro.props;
const repo = 'https://github.com/abhiudayg/shipnote';
const navItems = [
  { label: 'Features', href: '/features/' },
  { label: 'How it works', href: '/how-it-works/' },
  { label: 'Docs', href: '/docs/' },
  { label: 'Changelog', href: '/changelog/' },
];
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="flex min-h-screen flex-col bg-black font-sans text-white antialiased">
    <header class="sticky top-0 z-50 border-b border-white/[0.08] bg-black/80 backdrop-blur-md">
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5">
        <div class="flex items-center gap-3">
          <a href="/" class="flex items-center gap-2.5 text-[17px] font-semibold tracking-tight">
            <img src="/logo.svg" alt="" width="28" height="28" class="rounded-md" />
            shipnote
          </a>
          <span class="hidden rounded border border-white/[0.08] bg-zinc-900/60 px-2 py-0.5 font-mono text-xs text-zinc-400 sm:inline-flex">local-first</span>
        </div>
        <nav class="hidden items-center gap-6 text-sm md:flex">
          {navItems.map((item) => (
            <a
              href={item.href}
              class:list={[
                'transition-colors duration-150 hover:text-white',
                active === item.href ? 'text-white font-medium' : 'text-zinc-400',
              ]}
            >
              {item.label}
            </a>
          ))}
        </nav>
        <div class="flex items-center gap-3">
          <a
            href={repo}
            class="hidden items-center gap-2 rounded-lg border border-white/[0.08] bg-zinc-950 px-3 py-1.5 text-sm text-zinc-300 transition-colors hover:border-white/[0.18] hover:text-white sm:inline-flex"
          >
            Star on GitHub
          </a>
          <a
            href="/setup/"
            class="rounded-lg bg-sky-400 px-3.5 py-1.5 text-sm font-semibold text-black transition-colors hover:bg-sky-300"
          >
            Get started
          </a>
        </div>
      </div>
    </header>

    <div class="dot-grid flex-1">
      <slot />
    </div>

    <footer class="border-t border-white/[0.08] bg-black py-10 text-sm text-zinc-400">
      <div class="mx-auto flex max-w-6xl flex-col gap-6 px-5 md:flex-row md:items-center md:justify-between">
        <div class="flex items-center gap-3">
          <img src="/logo.svg" alt="" width="22" height="22" class="rounded" />
          <span class="font-medium text-white">shipnote</span>
          <span class="text-zinc-600">•</span>
          <span>© {year} shipnote</span>
        </div>
        <nav class="flex flex-wrap gap-x-5 gap-y-2">
          <a href="/docs/" class="hover:text-white">Documentation</a>
          <a href={repo} class="hover:text-white">GitHub</a>
          <a href="/roadmap/" class="hover:text-white">Roadmap</a>
          <a href="/changelog/" class="hover:text-white">Changelog</a>
          <a href="/privacy/" class="hover:text-white">Privacy</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
